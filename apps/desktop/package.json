{
  "name": "@sycamore/desktop",
  "version": "0.1.0",
  "private": true,
  "description": "Church attendance for Sycamore RPC",
  "author": "Sycamore RPC",
  "main": "dist/main.cjs",
  "scripts": {
    "build": "vite build --config vite.config.ts --configLoader runner && node build.mjs"
  },
  "dependencies": {
    "@fluentui/react-components": "^9.74.9",
    "@fluentui/react-icons": "^2.0.300",
    "@sycamore/shared": "0.1.0",
    "chart.js": "^4.5.1",
    "electron-updater": "^6.6.2",
    "exceljs": "^4.4.0",
    "firebase": "^13.0.0",
    "papaparse": "^5.5.3",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@types/papaparse": "^5.3.16",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.4",
    "electron": "^44.9.0",
    "electron-builder": "^26.0.12",
    "esbuild": "^0.25.11",
    "vite": "^7.1.10"
  },
  "build": {
    "appId": "org.sycamorerpc.attendance",
    "productName": "Sycamore RPC",
    "directories": {
      "output": "../../release"
    },
    "files": [
      "dist/**/*",
      "package.json"
    ],
    "win": {
      "target": "nsis"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "publish": [
      {
        "provider": "github",
        "owner": "z3r0Colt",
        "repo": "churchattendance"
      }
    ]
  }
}
