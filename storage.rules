rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function staff() {
      let a = firestore.get(/databases/(default)/documents/staffAccess/$(request.auth.uid)).data;
      let sid = request.auth.token.get('passkeySession', '');
      return request.auth != null && request.auth.token.get('email_verified', false) && a.enabled == true && a.get('locked', false) == false &&
        request.auth.token.auth_time >= a.validAfter &&
        (request.auth.token.get('firebase', {}).get('sign_in_second_factor', '') in ['totp', 'phone'] ||
          (sid.matches('^[a-f0-9]{64}$') &&
            firestore.get(/databases/(default)/documents/staffSessions/$(sid)).data.uid == request.auth.uid &&
            firestore.get(/databases/(default)/documents/staffSessions/$(sid)).data.validAfter == a.validAfter &&
            firestore.get(/databases/(default)/documents/staffSessions/$(sid)).data.expiresAt > request.time));
    }
    function roles() { return request.auth != null && staff() ? firestore.get(/databases/(default)/documents/staffAccess/$(request.auth.uid)).data.roles : []; }
    function reader() { return roles().hasAny(['admin', 'pastor', 'clerk', 'elder', 'deacon', 'readOnly']); }
    function editor() { return roles().hasAny(['admin', 'pastor', 'clerk', 'elder']); }
    match /bulletins/{week}/{filename} {
      allow read: if editor();
      allow create: if resource == null && editor() && week.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$') && filename.matches('^[A-Za-z0-9_-]+[.]pdf$') && request.resource.size > 4 && request.resource.size <= 20 * 1024 * 1024 && request.resource.contentType == 'application/pdf';
      allow update, delete: if false;
    }
    match /messageAttachments/{uid}/{filename} {
      allow read: if editor();
      allow create: if resource == null && editor() && request.auth.uid == uid && filename.matches('^[A-Za-z0-9_-]+[.]pdf$') && request.resource.size > 4 && request.resource.size <= 20 * 1024 * 1024 && request.resource.contentType == 'application/pdf';
      allow update, delete: if false;
    }
    match /photos/{personId}/{filename} {
      allow read: if reader();
      allow create, update: if editor() && request.resource.size < 5 * 1024 * 1024 && request.resource.contentType.matches('image/(jpeg|png|webp)');
      allow delete: if editor();
    }
    match /{path=**} { allow read, write: if false; }
  }
}
