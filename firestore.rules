rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function staff() {
      let a = get(/databases/$(database)/documents/staffAccess/$(request.auth.uid)).data;
      let f = request.auth.token.get('firebase', {});
      let sid = request.auth.token.get('passkeySession', '');
      return request.auth != null && request.auth.token.get('email_verified', false) && a.enabled == true && a.get('locked', false) == false &&
        request.auth.token.auth_time >= a.validAfter &&
        (f.get('sign_in_second_factor', '') in ['totp', 'phone'] ||
          (sid.matches('^[a-f0-9]{64}$') &&
            get(/databases/$(database)/documents/staffSessions/$(sid)).data.uid == request.auth.uid &&
            get(/databases/$(database)/documents/staffSessions/$(sid)).data.validAfter == a.validAfter &&
            get(/databases/$(database)/documents/staffSessions/$(sid)).data.expiresAt > request.time));
    }
    function roles() { return request.auth != null && staff() ? get(/databases/$(database)/documents/staffAccess/$(request.auth.uid)).data.roles : []; }
    function session() { return roles().hasAny(['pastor', 'clerk', 'elder']); }
    function editor() { return roles().hasAny(['admin', 'pastor', 'clerk', 'elder']); }
    function reader() { return roles().hasAny(['admin', 'pastor', 'clerk', 'elder', 'deacon', 'readOnly']); }
    function attendanceWriter() { return roles().hasAny(['admin', 'pastor', 'clerk', 'elder', 'deacon', 'attendanceVolunteer']); }
    function attendanceReader() { return reader() || roles().hasAny(['attendanceVolunteer']); }
    function communicator() { return editor(); }
    function visibleMessage(data) { return communicator() && (data.sessionOnly == false || session()); }
    function validService() {
      let d = request.resource.data;
      return d.keys().hasAll(['serviceTypeId', 'date', 'notes', 'present', 'lastAttendancePersonId']) &&
        d.keys().hasOnly(['serviceTypeId', 'date', 'notes', 'present', 'lastAttendancePersonId']) &&
        d.serviceTypeId is string && d.date is string && d.date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$') &&
        d.notes is string && d.notes.size() <= 1000 && d.present is map && d.lastAttendancePersonId is string;
    }
    function validMark(personId) {
      let person = get(/databases/$(database)/documents/attendanceRoster/$(personId)).data;
      let marks = request.resource.data.present;
      return !(personId in marks) || (
        person.isDeceased == false && person.membershipStatus != 'former' &&
        marks[personId] is map && marks[personId].keys().hasAll(['at', 'method', 'byUid']) &&
        marks[personId].keys().hasOnly(['at', 'method', 'byUid']) &&
        marks[personId].at == request.time && marks[personId].byUid == request.auth.uid &&
        marks[personId].method in ['roll', 'kiosk']);
    }
    function validAttendanceUpdate() {
      let changed = request.resource.data.present.diff(resource.data.present).affectedKeys();
      let personId = request.resource.data.lastAttendancePersonId;
      return personId.matches('^[A-Za-z0-9_-]{1,128}$') &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['present', 'lastAttendancePersonId']) &&
        changed.hasOnly([personId]) && validMark(personId);
    }
    match /attendanceRoster/{personId} { allow read: if attendanceReader(); allow write: if false; }
    match /people/{personId} {
      allow read: if reader(); allow write: if false;
      match /{subcollection}/{id} { allow read: if reader() && subcollection in ['membershipEvents', 'sacraments', 'offices']; allow write: if false; }
    }
    match /households/{id} { allow read: if reader(); allow write: if false; }
    match /serviceTypes/{id} {
      allow read: if attendanceReader();
      allow write: if false;
    }
    match /services/{id} {
      allow read: if attendanceReader();
      allow create: if attendanceWriter() && validService() && request.resource.data.present.size() == 0 && request.resource.data.lastAttendancePersonId == '' && request.resource.data.notes == '' &&
        id == request.resource.data.serviceTypeId + '_' + request.resource.data.date &&
        get(/databases/$(database)/documents/serviceTypes/$(request.resource.data.serviceTypeId)).data.isActive == true;
      allow update: if attendanceWriter() && validService() && validAttendanceUpdate();
      allow delete: if false;
    }
    // Private records are decrypted only by audited callable APIs and never cached here.
    match /sessionPrivate/{id} { allow read, write: if false; }
    match /careNotes/{id} { allow read, write: if false; }
    match /followUps/{id} { allow read, write: if false; }
    match /diaconalTasks/{id} {
      allow read, write: if false;
    }
    match /auditLog/{id} { allow read, write: if false; }
    // Visit plans, including invited deacons' logistics, are served only by audited callables.
    match /pastoralVisits/{id} { allow read, write: if false; }
    match /visitRounds/{id} { allow read, write: if false; }
    match /shepherdingSettings/{id} { allow read, write: if false; }
    match /settings/{id} { allow read: if attendanceReader() && id == 'church'; allow write: if false; }
    match /users/{uid} { allow read: if attendanceReader() && (request.auth.uid == uid || roles().hasAny(['admin'])); allow write: if false; }
    match /messages/{id} {
      allow read: if visibleMessage(resource.data);
      allow write: if false;
      match /recipients/{recipientId} { allow read: if visibleMessage(get(/databases/$(database)/documents/messages/$(id)).data); allow write: if false; }
    }
    match /smsInbox/{id} { allow read: if communicator(); allow write: if false; }
    match /messageTemplates/{id} { allow read: if communicator(); allow write: if false; }
    match /savedAudiences/{id} { allow read: if communicator(); allow write: if false; }
    match /communicationSettings/{id} { allow read: if communicator() && id == 'church'; allow write: if false; }
    match /automationStatus/{id} { allow read: if communicator() && id == 'church'; allow write: if false; }
    match /bulletins/{id} { allow read: if communicator(); allow write: if false; }
    match /elderDistricts/{id} { allow read: if reader(); allow write: if false; }
    match /groups/{id} {
      allow read: if reader(); allow write: if false;
      match /meetings/{date} { allow read: if reader(); allow write: if false; }
    }
    match /events/{id} {
      allow read: if reader(); allow write: if false;
      match /rsvps/{personId} { allow read: if reader(); allow write: if false; }
    }
    match /serving/{id} { allow read: if reader(); allow write: if false; }
    match /reportSettings/{id} { allow read: if reader(); allow write: if false; }
    match /portalAccess/{id} { allow read: if roles().hasAny(['admin','pastor']); allow write: if false; }
    match /eventPublications/{id} { allow read: if editor(); allow write: if false; }
    match /onlineSubmissions/{id} { allow read: if editor(); allow write: if false; }
    match /consentEvents/{id} { allow read: if communicator(); allow write: if false; }
    match /{document=**} { allow read, write: if false; }
  }
}
