# Copy to .env for local emulators. Never commit .env files.
VITE_USE_EMULATORS=true
VITE_FIREBASE_PROJECT_ID=demo-sycamore
# For production set VITE_USE_EMULATORS=false and fill the public Firebase web config.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_APP_ID=
# Public reCAPTCHA Enterprise site key for the separately hosted portal.
# Server secrets never belong in VITE_ variables.
VITE_PORTAL_APP_CHECK_SITE_KEY=
# Exact HTTPS origin hosting /staff-security. Also set server STAFF_AUTH_ORIGIN and STAFF_AUTH_RP_ID.
VITE_STAFF_AUTH_ORIGIN=


# Required for production. Public, operator-approved deployment binding (never an editable church setting).
# Both Firebase project values must match; the origin must exactly match the browser origin.
VITE_DEPLOYMENT_PROJECT_ID=
VITE_CHURCH_ID=
VITE_CHURCH_ORIGIN=
# Matching Functions parameter: CHURCH_ID. Set through trusted deployment configuration.
# Existing calendar deployments should retain their old CALENDAR_UID_DOMAIN to preserve feed UIDs.
