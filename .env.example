# Copy to .env for local emulators. Never commit .env files.
VITE_USE_EMULATORS=true
VITE_FIREBASE_PROJECT_ID=demo-sycamore
# For production set VITE_USE_EMULATORS=false and fill the public Firebase web config.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_APP_ID=
